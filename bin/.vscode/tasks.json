{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar GERENC_RESERVAS_HOTEL",
      "type": "shell",
      "command": "gcc",
      "args": [
        "src/main.c",
        "src/funcoes.c",
        "-Iinclude",
        "-o",
        "bin/main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Compila o projeto GERENC_RESERVAS_HOTEL"
    },
    {
      "label": "Executar GERENC_RESERVAS_HOTEL",
      "type": "shell",
      "command": "cmd",
      "args": [
        "/c",
        "bin\\main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared"
      }
    }
  ]
}



